<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TraceMap.Core\TraceMap.Core.csproj" />
    <ProjectReference Include="..\TraceMap.Reduction\TraceMap.Reduction.csproj" />
    <ProjectReference Include="..\TraceMap.Storage\TraceMap.Storage.csproj" />
    <ProjectReference Include="..\TraceMap.Reporting\TraceMap.Reporting.csproj" />
    <ProjectReference Include="..\TraceMap.EndpointAlignment\TraceMap.EndpointAlignment.csproj" />
    <ProjectReference Include="..\TraceMap.Combine\TraceMap.Combine.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>tracemap</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <TraceMapDistributionKind Condition="'$(TraceMapDistributionKind)' == ''">source-build</TraceMapDistributionKind>
    <IsPackable Condition="'$(TraceMapPackAsTool)' != 'true'">false</IsPackable>
    <IsPackable Condition="'$(TraceMapPackAsTool)' == 'true'">true</IsPackable>
    <PackAsTool Condition="'$(TraceMapPackAsTool)' == 'true'">true</PackAsTool>
    <ToolCommandName Condition="'$(TraceMapPackAsTool)' == 'true'">tracemap</ToolCommandName>
    <PackageId Condition="'$(TraceMapPackAsTool)' == 'true'">TraceMap.Tool</PackageId>
    <PackageDescription Condition="'$(TraceMapPackAsTool)' == 'true'">Deterministic repository evidence scanner and review tooling.</PackageDescription>
    <PackageReadmeFile Condition="'$(TraceMapPackAsTool)' == 'true'">README.md</PackageReadmeFile>
    <Authors Condition="'$(TraceMapPackAsTool)' == 'true'">TraceMap contributors</Authors>
    <PackageLicenseExpression Condition="'$(TraceMapPackAsTool)' == 'true'">MIT</PackageLicenseExpression>
    <RepositoryUrl Condition="'$(TraceMapPackAsTool)' == 'true'">https://github.com/joefeser/tracemap</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TraceMapDistributionKind" Value="$(TraceMapDistributionKind)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TraceMapPackAsTool)' == 'true'">
    <None Include="../../../docs/LOCAL_REVIEW_WORKFLOW.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="SetTraceMapSourceState" BeforeTargets="CoreCompile">
    <Exec Command="git status --porcelain --untracked-files=all"
          WorkingDirectory="$(MSBuildProjectDirectory)/../../.."
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="TraceMapGitStatusExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="TraceMapGitStatusLines" />
    </Exec>
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)/../../.."
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="TraceMapGitHeadExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="TraceMapGitHeadLines" />
    </Exec>
    <PropertyGroup>
      <TraceMapSourceState Condition="'$(TraceMapGitStatusExitCode)' != '0'">unavailable</TraceMapSourceState>
      <TraceMapSourceState Condition="'$(TraceMapGitStatusExitCode)' == '0' and '@(TraceMapGitStatusLines)' == ''">clean</TraceMapSourceState>
      <TraceMapSourceState Condition="'$(TraceMapGitStatusExitCode)' == '0' and '@(TraceMapGitStatusLines)' != ''">dirty</TraceMapSourceState>
      <TraceMapSourceCommit Condition="'$(TraceMapGitHeadExitCode)' == '0'">@(TraceMapGitHeadLines)</TraceMapSourceCommit>
      <TraceMapSourceCommit Condition="'$(TraceMapSourceCommit)' == ''">unavailable</TraceMapSourceCommit>
    </PropertyGroup>
    <Error Condition="'$(TraceMapPackAsTool)' == 'true' and '$(TraceMapSourceState)' != 'clean'"
           Text="TraceMapToolPackageRequiresCleanSource" />
    <Error Condition="'$(TraceMapPackAsTool)' == 'true' and '$(TraceMapSourceCommit)' == 'unavailable'"
           Text="TraceMapToolPackageRequiresSourceCommit" />
    <ItemGroup>
      <TraceMapSourceMetadataLines Include="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;TraceMapSourceState&quot;, &quot;$(TraceMapSourceState)&quot;)]" />
      <TraceMapSourceMetadataLines Include="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;TraceMapSourceCommit&quot;, &quot;$(TraceMapSourceCommit)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)TraceMapSourceState.g.cs"
      Lines="@(TraceMapSourceMetadataLines)"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)TraceMapSourceState.g.cs" />
    </ItemGroup>
  </Target>

</Project>
