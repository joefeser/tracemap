<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Era code: not null-annotated, uses obsolete Cecil Import and
         StrongNameKeyPair APIs that never execute in the oracle path. -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CS0612;SYSLIB0017</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TraceMap.Tests" />
    <Using Include="NetPerf.Common" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
