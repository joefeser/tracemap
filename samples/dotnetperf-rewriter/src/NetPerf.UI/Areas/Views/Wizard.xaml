<UserControl
	x:Class="MetadataDashboard.NetperfUI.Areas.Views.Wizard"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:cal="http://www.caliburnproject.org"
	mc:Ignorable="d"
	d:DesignHeight="300"
	d:DesignWidth="300">
	
	<DockPanel LastChildFill="True"
		Margin="10">

		<Grid
			DockPanel.Dock="Bottom" 
			Margin="0,10,0,0">
			<Grid.Resources>
				<Style
					TargetType="Button">
					<Setter
						Property="Padding"
						Value="8,4,8,4" />
				</Style>
			</Grid.Resources>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button
				Content="&lt; Back"
				cal:Message.Attach="PreviousStep"
				Grid.Column="0" />

			<Button
				Content="Next &gt;"
				Margin="10,0,10,0"
				cal:Message.Attach="NextStep"
				Grid.Column="1" />

			<Button
				Content="Finish"
				cal:Message.Attach="FinishWizard"
				Grid.Column="2" />

			<Button
				Content="Cancel"
				cal:Message.Attach="CancelWizard"
				Grid.Column="4" />
		</Grid>
		
		<TabControl
			ItemsSource="{Binding Items}"
			SelectedItem="{Binding ActiveItem}"
			TabStripPlacement="Left">
			<TabControl.ItemContainerStyle>
				<Style
					TargetType="{x:Type TabItem}">
					<Setter
						Property="IsEnabled"
						Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.IsSequentialWizard, Converter={StaticResource InvertBoolean}}" />
				</Style>
			</TabControl.ItemContainerStyle>
			<TabControl.ItemTemplate>
				<DataTemplate>
					<StackPanel
						Orientation="Horizontal">
						<TextBlock
							Text="> "
							Visibility="{Binding Path=IsActive, Converter={StaticResource  BooleanToCollapsed}}" />
						<TextBlock
							Text="{Binding DisplayName}" />
					</StackPanel>

				</DataTemplate>
			</TabControl.ItemTemplate>
			<TabControl.ContentTemplate>
				<DataTemplate>
					<ContentControl
						cal:View.Model="{Binding}" />
				</DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>

	</DockPanel>
</UserControl>
