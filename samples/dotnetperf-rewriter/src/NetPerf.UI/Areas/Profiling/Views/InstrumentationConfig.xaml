<infra:NPUserControl
	x:Class="MetadataDashboard.NetperfUI.Areas.Profiling.Views.InstrumentationConfig"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:cal="http://www.caliburnproject.org"
	xmlns:infra="clr-namespace:MetadataDashboard.NetperfUI.Infrastructure">
	<ScrollViewer
		VerticalScrollBarVisibility="Auto"
		HorizontalScrollBarVisibility="Auto">
		<AdornerDecorator>
			<Grid
				Margin="10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />

					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />

					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>

				<Label
					Grid.Row="0"
					Grid.Column="0"
					Grid.ColumnSpan="4"
					ToolTip="{Binding HelpForApplicationExecutable, Mode=OneTime}">Application Executable</Label>
				<TextBox
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Name="ApplicationToRun" />
				<Button
					Grid.Row="1"
					Grid.Column="3"
					Content=" . . . "
					cal:Message.Attach="PickExecutableFile"
					Margin="4,0,0,0"
					VerticalAlignment="Stretch" />

				<Label
					Grid.Row="2"
					Grid.Column="0"
					Grid.ColumnSpan="4"
					ToolTip="{Binding HelpForApplicationParameters, Mode=OneTime}">Application Parameters</Label>
				<TextBox
					Grid.Row="3"
					Grid.Column="0"
					Grid.ColumnSpan="4"
					Name="ApplicationParameters" />

				<Label
					Grid.Row="4"
					Grid.Column="0"
					Grid.ColumnSpan="4"
					ToolTip="{Binding HelpForWorkingFolder, Mode=OneTime}">Working Folder</Label>
				<TextBox
					Grid.Row="5"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Name="WorkingFolder" />
				<Button
					Grid.Row="5"
					Grid.Column="3"
					Content=" . . . "
					cal:Message.Attach="PickWorkingFolder"
					Margin="4,0,0,0"
					VerticalAlignment="Stretch" />

				<Label
					Grid.Row="6"
					Grid.Column="0"
					Grid.ColumnSpan="4">Reports</Label>

				<CheckBox
					Grid.Row="7"
					Grid.Column="0"
					Margin="5"
					Content="HTML Report"
					Name="SummaryReportIsSelected"
					ToolTip="{Binding HelpForHTMLReport, Mode=OneTime}"/>
				<TextBox
					Grid.Row="7"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					Name="SummaryReportPath"
					IsEnabled="{Binding Path=SummaryReportIsSelected}"
					VerticalAlignment="Center" />
				<Button
					Grid.Row="7"
					Grid.Column="3"
					Content=" . . . "
					cal:Message.Attach="PickSummaryReportPath"
					IsEnabled="{Binding Path=SummaryReportIsSelected}"
					Margin="4,0,0,0"
					VerticalAlignment="Center" />

				<CheckBox
					Grid.Row="8"
					Grid.Column="0"
					Margin="5"
					Content="XML Report"
					Name="ExtractReportIsSelected"
					ToolTip="{Binding HelpForXMLReport, Mode=OneTime}"/>
				<TextBox
					Grid.Row="8"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					Name="ExtractReportPath"
					IsEnabled="{Binding Path=ExtractReportIsSelected}"
					VerticalAlignment="Center" />
				<Button
					Grid.Row="8"
					Grid.Column="3"
					Content=" . . . "
					IsEnabled="{Binding Path=ExtractReportIsSelected}"
					cal:Message.Attach="PickExtractReportPath"
					Margin="4,0,0,0"
					VerticalAlignment="Center" />

				<Label
					Grid.Row="9"
					Grid.Column="0"
					Grid.ColumnSpan="4"
					ToolTip="{Binding HelpForStrongNameKeyFile, Mode=OneTime}">Strong Name Public Key File</Label>
				<TextBox
					Grid.Row="10"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					Name="StrongNameKeyFile" />
				<Button
					Grid.Row="10"
					Grid.Column="3"
					Content=" . . . "
					cal:Message.Attach="PickStrongNameKey"
					Margin="4,0,0,0"
					VerticalAlignment="Stretch" />

				<Label
					Grid.Row="11"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					ToolTip="{Binding HelpForAssembliesToInstrument, Mode=OneTime}">Assemblies to Instrument</Label>

				<Button
					Grid.Row="11"
					Grid.Column="2"
					Grid.ColumnSpan="2"
					Content=" Pick more Assemblies "
					cal:Message.Attach="PickAssemblies"
					VerticalAlignment="Center"
					HorizontalAlignment="Right" />

				<ListView
					x:Name="IncludedAssemblies"
					AllowDrop="True"
					Drop="IncludedAssemblies_Drop"
					DragEnter="IncludedAssemblies_DragEnter"
					Grid.Row="12"
					Grid.Column="0"
					Grid.ColumnSpan="4"
					MinHeight="100">
					<i:Interaction.Triggers>
						<i:EventTrigger
							EventName="KeyDown">
							<cal:ActionMessage
								MethodName="KeyPressed">
								<cal:Parameter
									Value="$eventArgs"></cal:Parameter>
								<cal:Parameter
									Value="{Binding ElementName=IncludedAssemblies}"></cal:Parameter>
							</cal:ActionMessage>
						</i:EventTrigger>
					</i:Interaction.Triggers>
				</ListView>

			</Grid>
		</AdornerDecorator>
	</ScrollViewer>

</infra:NPUserControl>
