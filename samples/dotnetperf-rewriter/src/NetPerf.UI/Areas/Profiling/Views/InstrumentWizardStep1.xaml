<infra:NPUserControl
	x:Class="MetadataDashboard.NetperfUI.Areas.Profiling.Views.InstrumentWizardStep1"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:cal="http://www.caliburnproject.org"
	xmlns:infra="clr-namespace:MetadataDashboard.NetperfUI.Infrastructure"
	mc:Ignorable="d"
	d:DesignHeight="300"
	d:DesignWidth="300">
	<AdornerDecorator>
		<Grid
			Margin="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="10" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Grid.ColumnSpan="4"
				TextWrapping="Wrap"
				Text="{Binding HelpForApplicationExecutable, Mode=OneTime}" />

			<Label
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="4">Application Executable</Label>
			<TextBox
				Grid.Row="2"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Name="ApplicationToRun" />
			<Button
				Grid.Row="2"
				Grid.Column="3"
				Content=" . . . "
				cal:Message.Attach="PickExecutableFile"
				Margin="4,0,0,0"
				VerticalAlignment="Stretch" />

			<TextBlock
				Grid.Row="4"
				Grid.Column="0"
				Grid.ColumnSpan="4"
				TextWrapping="Wrap"
				Text="{Binding HelpForApplicationParameters, Mode=OneTime}" />

			<Label
				Grid.Row="5"
				Grid.Column="0"
				Grid.ColumnSpan="4">Application Parameters</Label>
			<TextBox
				Grid.Row="6"
				Grid.Column="0"
				Grid.ColumnSpan="4"
				Name="ApplicationParameters" />

			<TextBlock
				Grid.Row="8"
				Grid.Column="0"
				Grid.ColumnSpan="4"
				TextWrapping="Wrap"
				Text="{Binding HelpForWorkingFolder, Mode=OneTime}" />

			<Label
				Grid.Row="9"
				Grid.Column="0"
				Grid.ColumnSpan="4">Working Folder</Label>
			<TextBox
				Grid.Row="10"
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Name="WorkingFolder" />
			<Button
				Grid.Row="10"
				Grid.Column="3"
				Content=" . . . "
				cal:Message.Attach="PickWorkingFolder"
				Margin="4,0,0,0"
				VerticalAlignment="Stretch" />
		</Grid>
	</AdornerDecorator>
</infra:NPUserControl>
