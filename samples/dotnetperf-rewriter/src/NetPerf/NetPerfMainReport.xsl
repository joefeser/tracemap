<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
    xmlns:msxsl="urn:schemas-microsoft-com:xslt" exclude-result-prefixes="msxsl">
  <xsl:output omit-xml-declaration="no" method="html" doctype-public="-//W3C//DTD XHTML 1.0 Strict//EN"
              doctype-system="http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd" encoding="utf-8" indent="yes"/>
  <xsl:variable name="includehtmlwrapper" select="'true'" />

  <!--These variables are used to control how many types, files and methods are rendered-->
  <xsl:variable name="topTypeCount" select="'20'" />
  <xsl:variable name="topMethodCount" select="'20'" />
  <xsl:variable name="topFileCount" select="'20'" />

  <xsl:variable name="reportversion" select="'2011.04.16 16.10'" />
  <!--xml:space="preserve"-->
  <xsl:template match="/">
    <xsl:choose>
      <xsl:when test="$includehtmlwrapper">
        <html>
          <head>
            <title>
              DotNet Perf Timing Report - v<xsl:value-of select="$reportversion"/>
            </title>
            <xsl:comment>
              DotNetPerf Timing Report
              Copyright © 2010-2013 Joe Feser and Stephen Ward
              http://www.dotnetperf.com or follow @dotnetperf for more information.
            </xsl:comment>
            <xsl:comment>Generated by the Joe Feser @joefeser</xsl:comment>
            <xsl:call-template name="css" />
          </head>
          <body>
            <table cellpadding="2" cellspacing="0">
              <tbody>
                <xsl:call-template name="header" />
                <xsl:call-template name="body" />
              </tbody>
            </table>
          </body>
        </html>
      </xsl:when>
      <xsl:otherwise>
        <xsl:call-template name="css" />
        <xsl:call-template name="body" />
      </xsl:otherwise>
    </xsl:choose>
  </xsl:template>

  <xsl:template name="header">

    <tr class="last">
      <td colspan="6">
        <table width="100%" border="0" cellpadding="0" cellspacing="0" class="heading">
          <tbody>
            <tr>
              <td colspan="2" class="headingLargeTop">
                DotNetPerf Timing Report - http://www.dotnetperf.com or follow @dotnetperf for more information.
              </td>
            </tr>
            <tr>
              <td colspan="2" style="height: 20px">
              </td>
            </tr>
            <tr>
              <td colspan="2">
                Copyright © 2010-2013 Joe Feser and Stephen Ward.
              </td>
            </tr>
            <tr>
              <td>
                Generated Time: <xsl:value-of select="/timingdata/@generatedTimeDate"/>
              </td>
              <td style="text-align:right;">
                Template version: <xsl:value-of select="$reportversion"/>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>

  </xsl:template>

  <xsl:template name="body">

    <xsl:call-template name="types"></xsl:call-template>

    <tr class="last">
      <td colspan="6" style="height: 30px"></td>
    </tr>

    <xsl:call-template name="files"></xsl:call-template>

    <tr class="last">
      <td colspan="6" style="height: 30px"></td>
    </tr>

    <xsl:call-template name="methods"></xsl:call-template>

    <tr class="last">
      <td colspan="6" style="height: 50px"></td>
    </tr>

    <xsl:call-template name="alltypes"></xsl:call-template>

    <tr class="last">
      <td colspan="6" style="height: 50px"></td>
    </tr>

  </xsl:template>

  <xsl:template name="files">

    <tr class="last">
      <td colspan="6" class="headingLargeTop">Source Files</td>
    </tr>

    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topFileCount" /> source files for time not including children
      </td>
    </tr>
    <xsl:call-template name="fileHeader"/>
    <xsl:for-each select="/timingdata/files/file">
      <xsl:sort select="@methodPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topFileCount">
        <xsl:call-template name="fileBody" />
      </xsl:if>
    </xsl:for-each>

    <tr class="last">
      <td colspan="6" style="height: 20px"></td>
    </tr>

    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topFileCount" /> source files children time
      </td>
    </tr>
    <xsl:call-template name="fileHeader"/>
    <xsl:for-each select="/timingdata/files/file">
      <xsl:sort select="@childPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topFileCount">
        <xsl:call-template name="fileBody" />
      </xsl:if>
    </xsl:for-each>

    <tr class="last">
      <td colspan="6" style="height: 20px"></td>
    </tr>

    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topFileCount" /> types total time
      </td>
    </tr>
    <xsl:call-template name="fileHeader"/>
    <xsl:for-each select="/timingdata/files/file">
      <xsl:sort select="@methodPercent + @childPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topFileCount">
        <xsl:call-template name="fileBody" />
      </xsl:if>
    </xsl:for-each>

  </xsl:template>

  <xsl:template name="fileHeader">
    <tr>
      <td class="indent twopxtb">
      </td>
      <td class="heading twopxtb" colspan="2">
        File Name
      </td>
      <td class="heading twopxtb">
        Method %
      </td>
      <td class="heading twopxtb">
        Child %
      </td>
      <td class="heading twopxtb">
        Total %
      </td>
    </tr>
  </xsl:template>

  <xsl:template name="fileBody">
    <xsl:variable name="moduleId" select="@moduleId" />
    <!--<file fileId="13" language="CSharp" 
    moduleId="1303649044" 
    uri="C:\dev\NetPerf\Netperf.Tests.Bootstrapper\Program.cs" 
    visited="1" childPercent="47.2980" methodPercent="15.6763" totalPercent="41.0935" />-->
    <tr>
      <td class="indent">
      </td>
      <td colspan="2">
        <div class="nameColumn500">
          <xsl:attribute name="title">
            <xsl:value-of select="/timingdata/modules/module[@moduleId = $moduleId]/@moduleName"/>
          </xsl:attribute>
          <xsl:value-of select="@uri"/>
        </div>
      </td>
      <td class="pc">
        <xsl:value-of select="concat(format-number(@methodPercent,'#0.00'), '')"/>
      </td>
      <td class="pc">
        <xsl:value-of select="concat(format-number(@childPercent,'#0.00'), '')"/>
      </td>
      <td class="pc">
        <xsl:value-of select="concat(format-number(@methodPercent + @childPercent,'#0.00'), '')"/>
      </td>
    </tr>
  </xsl:template>

  <xsl:template name="types">
    <tr class="last">
      <td colspan="6" class="headingLargeTop">Types</td>
    </tr>
    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topTypeCount" /> types for time not including children
      </td>
    </tr>
    <xsl:call-template name="typeHeader"/>
    <xsl:for-each select="/timingdata/types/type">
      <xsl:sort select="@methodPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topTypeCount">
        <xsl:call-template name="typeBody" />
      </xsl:if>
    </xsl:for-each>

    <tr class="last">
      <td colspan="6" style="height: 20px"></td>
    </tr>

    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topTypeCount" /> types children time
      </td>
    </tr>
    <xsl:call-template name="typeHeader"/>
    <xsl:for-each select="/timingdata/types/type">
      <xsl:sort select="@childPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topTypeCount">
        <xsl:call-template name="typeBody" />
      </xsl:if>
    </xsl:for-each>

    <tr class="last">
      <td colspan="6" style="height: 20px"></td>
    </tr>

    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topTypeCount" /> types total time
      </td>
    </tr>
    <xsl:call-template name="typeHeader"/>
    <xsl:for-each select="/timingdata/types/type">
      <xsl:sort select="@methodPercent + @childPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topTypeCount">
        <xsl:call-template name="typeBody" />
      </xsl:if>
    </xsl:for-each>

  </xsl:template>

  <xsl:template name="alltypes">
    <tr class="last">
      <td colspan="6" class="headingLargeTop">All Types and Methods</td>
    </tr>

    <xsl:call-template name="typeHeader">
      <xsl:with-param name="displayNamespace" select="'0'" />
    </xsl:call-template>

    <xsl:for-each select="/timingdata/types/type">
      <xsl:sort select="@typeSignature" data-type="text" order="ascending"  />
      <xsl:variable name="moduleId" select="@moduleId" />
      <xsl:variable name="typeId" select="@typeId" />

      <xsl:if test="count(/timingdata/methods/method[@moduleId = $moduleId and @typeId = $typeId]) > 0">
        <xsl:call-template name="typeBody">
          <xsl:with-param name="displayNamespace" select="'0'" />
        </xsl:call-template>

        <xsl:for-each select="/timingdata/methods/method[@moduleId = $moduleId and @typeId = $typeId]">
          <xsl:sort select="@methodName" data-type="text" order="ascending"  />
          <xsl:call-template name="methodBody">
            <xsl:with-param name="type" select="'0'" />
          </xsl:call-template>
        </xsl:for-each>
      </xsl:if>

    </xsl:for-each>

    <tr class="last">
      <td colspan="6" style="height: 20px"></td>
    </tr>

  </xsl:template>

  <xsl:template name="typeHeader">
    <xsl:param name="displayNamespace">
      <xsl:text>1</xsl:text>
    </xsl:param>
    <tr>
      <td class="indent twopxtb">
      </td>
      <xsl:choose>
        <xsl:when test="$displayNamespace = '1'">
          <td class="heading twopxtb">
            Namespace
          </td>
          <td class="heading twopxtb">
            Type Name
          </td>
        </xsl:when>
        <xsl:otherwise>
          <td class="heading twopxtb">
            Full Type Name
          </td>
          <td class="heading twopxtb">
            Method Name
          </td>
        </xsl:otherwise>
      </xsl:choose>

      <td class="heading twopxtb">
        Method %
      </td>
      <td class="heading twopxtb">
        Child %
      </td>
      <td class="heading twopxtb">
        Total %
      </td>
    </tr>
  </xsl:template>

  <xsl:template name="typeBody">
    <xsl:param name="displayNamespace">
      <xsl:text>1</xsl:text>
    </xsl:param>
    <xsl:variable name="moduleId" select="@moduleId" />
    <!--childPercent="0.0000" methodPercent="0.0000"-->

    <!--<type moduleId="1303649044" typeId="1" typeSignature="&lt;Module&gt;" 
        typeName="&lt;Module&gt;" typeNameSpace="" visited="1" 
        childPercent="0.0000" methodPercent="0.0000" />-->
    <tr>
      <td>
        <xsl:attribute name="class" xml:space="preserve">indent<xsl:if test="$displayNamespace != '1'"> twopxtb</xsl:if></xsl:attribute>
        <xsl:if test="$displayNamespace != '1'">
          <a name="{$moduleId}_{@typeId}"></a>
        </xsl:if>
      </td>
      <xsl:choose>
        <xsl:when test="$displayNamespace = '1'">
          <td>
            <xsl:attribute name="title">
              <xsl:value-of select="/timingdata/modules/module[@moduleId = $moduleId]/@moduleName"/>
            </xsl:attribute>
            <xsl:value-of select="@typeNameSpace"/>
          </td>
          <td>
            <a href="#{$moduleId}_{@typeId}">
              <xsl:value-of select="@typeName"/>
            </a>
          </td>
        </xsl:when>
        <xsl:otherwise>
          <td class="twopxtb" colspan="2">
            <xsl:attribute name="title">
              <xsl:value-of select="/timingdata/modules/module[@moduleId = $moduleId]/@moduleName"/>
            </xsl:attribute>
            <xsl:value-of select="@typeNameSpace"/>.<xsl:value-of select="@typeName"/>
          </td>
        </xsl:otherwise>
      </xsl:choose>

      <td>
        <xsl:attribute name="class" xml:space="preserve">pc<xsl:if test="$displayNamespace != '1'"> twopxtb</xsl:if></xsl:attribute>
        <xsl:value-of select="concat(format-number(@methodPercent,'#0.00'), '')"/>
      </td>
      <td>
        <xsl:attribute name="class" xml:space="preserve">pc<xsl:if test="$displayNamespace != '1'"> twopxtb</xsl:if></xsl:attribute>
        <xsl:value-of select="concat(format-number(@childPercent,'#0.00'), '')"/>
      </td>
      <td>
        <xsl:attribute name="class" xml:space="preserve">pc<xsl:if test="$displayNamespace != '1'"> twopxtb</xsl:if></xsl:attribute>
        <xsl:value-of select="concat(format-number(@methodPercent + @childPercent,'#0.00'), '')"/>
      </td>
    </tr>
  </xsl:template>

  <xsl:template name="methods">
    <tr class="last">
      <td colspan="6" class="headingLargeTop">Methods</td>
    </tr>
    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topMethodCount" /> methods for time not including children
      </td>
    </tr>
    <xsl:call-template name="methodHeader"/>
    <xsl:for-each select="/timingdata/methods/method">
      <xsl:sort select="@methodPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topMethodCount">
        <xsl:call-template name="methodBody" />
      </xsl:if>
    </xsl:for-each>

    <tr class="last">
      <td colspan="6" style="height: 20px"></td>
    </tr>

    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topMethodCount" /> methods children time
      </td>
    </tr>
    <xsl:call-template name="methodHeader"/>
    <xsl:for-each select="/timingdata/methods/method">
      <xsl:sort select="@childPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topMethodCount">
        <xsl:call-template name="methodBody" />
      </xsl:if>
    </xsl:for-each>

    <tr class="last">
      <td colspan="6" style="height: 20px"></td>
    </tr>

    <tr>
      <td colspan="6" class="headingTop">
        Top <xsl:value-of select="$topMethodCount" /> methods total time
      </td>
    </tr>
    <xsl:call-template name="methodHeader"/>
    <xsl:for-each select="/timingdata/methods/method">
      <xsl:sort select="@methodPercent + @childPercent" data-type="number" order="descending"  />
      <xsl:if test="position() &lt;= $topMethodCount">
        <xsl:call-template name="methodBody" />
      </xsl:if>
    </xsl:for-each>

  </xsl:template>

  <xsl:template name="methodHeader">
    <xsl:param name="type">
      <xsl:text>1</xsl:text>
    </xsl:param>
    <tr>
      <td class="indent twopxtb">
      </td>
      <td class="heading twopxtb">
        <xsl:if test="$type = '1'">
          Type Name
        </xsl:if>
      </td>
      <td class="heading twopxtb">
        Method Name
      </td>
      <td class="heading twopxtb">
        Method %
      </td>
      <td class="heading twopxtb">
        Child %
      </td>
      <td class="heading twopxtb">
        Total %
      </td>
    </tr>
  </xsl:template>

  <xsl:template name="methodBody">
    <xsl:param name="type">
      <xsl:text>1</xsl:text>
    </xsl:param>
    <xsl:variable name="moduleId" select="@moduleId" />
    <xsl:variable name="typeId" select="@typeId" />
    <!--childPercent="0.0000" methodPercent="0.0000"-->

    <!--<type moduleId="1303649044" typeId="1" typeSignature="&lt;Module&gt;" 
        typeName="&lt;Module&gt;" typeNameSpace="" visited="1" 
        childPercent="0.0000" methodPercent="0.0000" />-->
    <tr>
      <td class="indent">
        <xsl:if test="$type != '1'">
          <a name="{$typeId}_{@methodId}"></a>
        </xsl:if>
      </td>
      <td>
        <div class="nameColumn200">
          <xsl:if test="$type = '1'">
            <xsl:value-of select="/timingdata/types/type[@moduleId = $moduleId and @typeId = $typeId]/@typeName"/>
          </xsl:if>
        </div>
      </td>
      <td>
        <div class="nameColumn">
          <xsl:choose>
            <xsl:when test="$type = '1'">
              <a href="#{$typeId}_{@methodId}">
                <xsl:value-of select="@methodNameWithParams"/>
              </a>
            </xsl:when>
            <xsl:otherwise>
              <xsl:value-of select="@methodNameWithParams"/>
            </xsl:otherwise>
          </xsl:choose>
        </div>
      </td>
      <td class="pc">
        <xsl:value-of select="concat(format-number(@methodPercent,'#0.00'), '')"/>
      </td>
      <td class="pc">
        <xsl:value-of select="concat(format-number(@childPercent,'#0.00'), '')"/>
      </td>
      <td class="pc">
        <xsl:value-of select="concat(format-number(@methodPercent + @childPercent,'#0.00'), '')"/>
      </td>
    </tr>
  </xsl:template>

  <xsl:template name="css">
    <style type="text/css">
      <xsl:text disable-output-escaping="yes">
body { 
  font: small verdana, arial, helvetica;
  font-size: 10px;
  color:#000000; 
}
a {
  color:#000000;
  text-decoration: none;
}
a:hover {
  color:#000000;
  text-decoration: underline;
}
table {
   border-collapse:collapse;
}
.twopxtb {
	border-top: 2px solid #000;
    border-bottom: 2px solid #000;
    vertical-align:text-top;
}
td {
    border-bottom: 1px solid #000;
    vertical-align:text-top;
}
.last td {
   border-bottom: none;
}
.table2 {
	table-layout:fixed;
	width:100%;
	border:1px solid #f00;
	word-wrap:break-word;
}
.indent {
  width:20px;
}
.pc {
  text-align:right;
}
.nameColumn {
  width:500px;
  overflow: hidden;
  word-wrap:break-word;
  vertical-align:text-top;
}
.nameColumn200 {
  width:300px;
  overflow: hidden;
  word-wrap:break-word;
  vertical-align:text-top;
}
.nameColumn500 {
  width:800px;
  overflow: hidden;
  word-wrap:break-word;
  vertical-align:text-top;
}
.headingTop {
  font-size: 12px;
  font-weight: bold;
}
.headingLargeTop {
  font-size: 14px;
  font-weight: bold;
}
.heading {
  font-weight: bold;
}
        </xsl:text>
    </style>
  </xsl:template>

</xsl:stylesheet>
