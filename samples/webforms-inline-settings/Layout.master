<%@ Master Language="VB" %>
<html ng-app="example"><body>
  <asp:ContentPlaceHolder ID="Main" runat="server"></asp:ContentPlaceHolder>
  <script src="/Portal/Desk/Scripts/panel.js"></script>
  <script>
    (function () {
      var tag = document.createElement("script");
      tag.src = '/assets/<%= AppSettings("SampleKey") %>/optional.js';
      document.head.appendChild(tag);
    }());
  </script>
</body></html>
