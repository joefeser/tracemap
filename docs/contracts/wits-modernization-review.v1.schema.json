{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemap.tools/contracts/wits-modernization-review.v1.schema.json",
  "title": "TraceMap private reviewed-modernization overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "overlayId", "evidence", "reviewState", "reviewer", "reviewedAtUtc", "decisions", "limitations"],
  "properties": {
    "schemaVersion": { "const": "wits-modernization-review.v1" },
    "overlayId": { "type": "string", "pattern": "^review-[0-9a-f]{20}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspectionSchemaVersion", "inspectionSha256", "scanId", "commitSha", "ruleId"],
      "properties": {
        "inspectionSchemaVersion": { "const": "webforms-batch-inspection.v1" },
        "inspectionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "scanId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" }
      }
    },
    "reviewState": { "enum": ["draft", "completed"] },
    "reviewer": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "reviewedAtUtc": { "type": ["string", "null"], "format": "date-time", "pattern": "Z$" },
    "decisions": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/decision" } },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["STATIC_EVIDENCE_NOT_RUNTIME_EXECUTION", "HUMAN_REVIEW_NOT_SCANNER_EVIDENCE", "PARTIAL_COVERAGE_PRESERVED"] }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "surfaceIds", "handlerFactId", "bindingFactIds", "verdict", "comment", "correction", "migrationDisposition"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^case-[0-9]{3}$" },
        "surfaceIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "handlerFactId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "bindingFactIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "verdict": { "enum": ["unreviewed", "expected-ui-only", "supported-backend-present", "backend-evidence-missing", "binding-or-source-mismatch", "needs-review"] },
        "comment": { "type": ["string", "null"], "maxLength": 4000 },
        "correction": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "statement"],
              "properties": {
                "category": { "enum": ["binding", "callee", "business-intent", "coverage", "other"] },
                "statement": { "type": "string", "minLength": 1, "maxLength": 4000 }
              }
            }
          ]
        },
        "migrationDisposition": { "enum": ["unassigned", "retain", "replace-angular", "replace-dotnet", "replace-postgresql", "replace-multiple", "retire", "manual-redesign", "defer"] }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "reviewer": { "type": "null" },
            "reviewedAtUtc": { "type": "null" }
          }
        },
        {
          "properties": {
            "reviewer": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
            "reviewedAtUtc": { "type": "string", "format": "date-time", "pattern": "Z$" }
          }
        }
      ]
    },
    {
      "if": { "properties": { "reviewState": { "const": "completed" } }, "required": ["reviewState"] },
      "then": {
        "properties": {
          "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "reviewedAtUtc": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "decisions": {
            "items": {
              "properties": {
                "verdict": { "not": { "const": "unreviewed" } }
              }
            }
          }
        }
      }
    }
  ]
}
