{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemap.tools/contracts/angular-dotnet-interaction-feedback.v1.schema.json",
  "title": "TraceMap categorical Angular and .NET interaction feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "outcome", "sourceCount", "sourceKinds",
    "scanStates", "reportCount", "reportStates", "unresolvedSignals",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "angular-dotnet-interaction-feedback.v1" },
    "runId": { "type": "string", "pattern": "^interaction-[0-9a-f]{20}$" },
    "outcome": { "enum": ["succeeded", "failed"] },
    "sourceCount": { "type": "integer", "minimum": 2, "maximum": 100 },
    "sourceKinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/countRow" }
    },
    "scanStates": {
      "type": "array",
      "items": { "$ref": "#/$defs/countRow" }
    },
    "reportCount": { "type": "integer", "minimum": 0, "maximum": 1602 },
    "reportStates": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportState" }
    },
    "unresolvedSignals": {
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    },
    "failureCode": {
      "type": ["string", "null"],
      "pattern": "^INTERACTION_RUN_[A-Z_]+$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "countRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "reportState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "classification", "coverage", "truncated"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "coverage": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "kind", "classification", "ruleId", "evidenceTier", "coverage", "count"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "evidenceTier": { "enum": ["Tier1Semantic", "Tier2Structural", "Tier3SyntaxOrTextual", "Tier4Unknown"] },
        "coverage": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
