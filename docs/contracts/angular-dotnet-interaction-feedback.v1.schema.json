{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemap.tools/contracts/angular-dotnet-interaction-feedback.v1.schema.json",
  "title": "TraceMap categorical Angular and .NET interaction feedback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runId", "outcome", "sourceCount", "sources", "sourceKinds",
    "scanStates", "reportCount", "reportStates", "unresolvedSignals",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "angular-dotnet-interaction-feedback.v1" },
    "runId": { "type": "string", "pattern": "^interaction-[0-9a-f]{20}$" },
    "outcome": { "enum": ["succeeded", "partial", "failed"] },
    "sourceCount": { "type": "integer", "minimum": 2, "maximum": 100 },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/sourceProvenance" }
    },
    "sourceKinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/countRow" }
    },
    "scanStates": {
      "type": "array",
      "items": { "$ref": "#/$defs/countRow" }
    },
    "reportCount": { "type": "integer", "minimum": 0, "maximum": 1602 },
    "reportStates": {
      "type": "array",
      "items": { "$ref": "#/$defs/reportState" }
    },
    "unresolvedSignals": {
      "type": "array",
      "items": { "$ref": "#/$defs/signal" }
    },
    "failureCode": {
      "type": ["string", "null"],
      "pattern": "^INTERACTION_RUN_[A-Z_]+$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "countRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "reportState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "classification", "coverage", "truncated"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "coverage": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "kind", "classification", "ruleId", "evidenceTier", "coverage", "count", "evidence"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "classification": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "evidenceTier": { "enum": ["Tier1Semantic", "Tier2Structural", "Tier3SyntaxOrTextual", "Tier4Unknown"] },
        "coverage": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/evidenceReference" }
        }
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "kind", "commitSha", "analysisLevel", "buildStatus"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["typescript", "dotnet"] },
        "commitSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "analysisLevel": { "type": "string", "minLength": 1 },
        "buildStatus": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "evidence_tier", "file_path", "line_span", "commit_sha", "extractor_version"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "evidence_tier": { "enum": ["Tier1Semantic", "Tier2Structural", "Tier3SyntaxOrTextual", "Tier4Unknown"] },
        "file_path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\).+$" },
        "line_span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_line", "end_line"],
          "properties": {
            "start_line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 }
          }
        },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "extractor_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
