{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemap.tools/schemas/scan-execution-receipt.v1.schema.json",
  "title": "TraceMap bounded scan execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "receiptId", "ruleId", "evidenceClass", "runId", "traceId",
    "scannerVersion", "extractorVersions", "repositoryIdentityHash", "commitSha",
    "authorizedScopeFingerprint", "sourceSnapshotDigest", "outcome", "coverage",
    "stages", "supportingFactIds", "supportingGapIds", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "scan-execution-receipt.v1" },
    "receiptId": { "type": "string", "pattern": "^receipt-[0-9a-f]{20}$" },
    "ruleId": { "const": "scanner.stage-receipt.v1" },
    "evidenceClass": { "const": "operational-diagnostic" },
    "runId": { "type": "string", "pattern": "^(scan|run)-[0-9a-f]{20}$" },
    "traceId": { "type": "string", "pattern": "^(scan|run)-[0-9a-f]{20}$" },
    "scannerVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "extractorVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "repositoryIdentityHash": { "$ref": "#/$defs/sha256" },
    "commitSha": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "authorizedScopeFingerprint": { "$ref": "#/$defs/sha256" },
    "sourceSnapshotDigest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "outcome": { "$ref": "#/$defs/outcome" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "stages": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/stage" }
    },
    "supportingFactIds": { "$ref": "#/$defs/supportingFactIds" },
    "supportingGapIds": { "$ref": "#/$defs/supportingGapIds" },
    "limitations": { "$ref": "#/$defs/limitations" },
    "sourceMetadataReconciliation": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sourceMetadataReconciliation" }
      ]
    },
    "pdbInputProvenance": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pdbInputProvenance" }
      ]
    },
    "pdbEvidenceSummary": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pdbEvidenceSummary" }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "outcome": { "enum": ["succeeded", "partial", "failed", "cancelled", "timed-out"] },
    "coverage": { "enum": ["semantic", "semantic-reduced", "syntax", "syntax-reduced", "unknown", "unchanged"] },
    "supportingFactIds": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^fact-[0-9a-f]{20}$" }
    },
    "supportingGapIds": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:fact-[0-9a-f]{20}|[0-9a-f]{24})$" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "sourceMetadataReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "ruleId", "extractorVersion", "coverageState",
        "boundedInputSha256", "compiledGeneratorSha256", "exactJoinCount", "explicitGapCount", "entries",
        "omittedEntryCount", "omittedEntrySha256"
      ],
      "properties": {
        "schemaVersion": { "const": "source-metadata-reconciliation.v1" },
        "ruleId": { "const": "dotnet.compiled.source-identity.v1" },
        "extractorVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "coverageState": { "enum": ["source-metadata-complete", "source-metadata-partial"] },
        "boundedInputSha256": { "$ref": "#/$defs/sha256" },
        "compiledGeneratorSha256": { "$ref": "#/$defs/sha256" },
        "exactJoinCount": { "type": "integer", "minimum": 0 },
        "explicitGapCount": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/sourceMetadataReconciliationEntry" }
        },
        "omittedEntryCount": { "type": "integer", "minimum": 0 },
        "omittedEntrySha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "sourceMetadataReconciliationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconciliationState", "sourceIdentity", "metadataIdentity", "sourceFactId",
        "compiledFactIds", "ruleId", "evidenceTier", "extractorVersion",
        "compiledProvenanceState", "provenanceBindingInputSha256", "gapKind", "limitation",
        "evidenceFactId", "filePath", "startLine", "endLine", "commitSha",
        "omittedCompiledFactIdCount", "omittedCompiledFactIdSha256"
      ],
      "properties": {
        "reconciliationState": { "enum": ["exact-one-candidate", "unjoined", "unsupported-source-adapter"] },
        "sourceIdentity": { "type": "string", "maxLength": 4096 },
        "metadataIdentity": { "type": "string", "maxLength": 4096 },
        "sourceFactId": { "type": "string", "maxLength": 25 },
        "compiledFactIds": { "$ref": "#/$defs/supportingFactIds" },
        "ruleId": { "const": "dotnet.compiled.source-identity.v1" },
        "evidenceTier": { "enum": ["Tier1Semantic", "Tier4Unknown"] },
        "extractorVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "compiledProvenanceState": { "type": "string", "maxLength": 32 },
        "provenanceBindingInputSha256": { "type": "string", "maxLength": 64 },
        "gapKind": { "type": "string", "maxLength": 128 },
        "limitation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidenceFactId": { "type": "string", "minLength": 1, "maxLength": 25 },
        "filePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "commitSha": { "type": "string", "minLength": 1, "maxLength": 64 },
        "omittedCompiledFactIdCount": { "type": "integer", "minimum": 0 },
        "omittedCompiledFactIdSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "pdbInputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "policyVersion", "generatorSha256", "extractorIdentities",
        "expectedInputs", "effectiveLimits", "outcomes", "boundedInputSha256",
        "artifactVisibility", "coverageState", "omittedInputCount", "omittedInputSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "pdb-input-provenance.v1" },
        "policyVersion": { "const": "explicit-pdb-input.v1" },
        "generatorSha256": { "$ref": "#/$defs/sha256" },
        "extractorIdentities": {
          "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "expectedInputs": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["safeLocator"],
            "properties": { "safeLocator": { "type": "string", "minLength": 1, "maxLength": 4096 } }
          }
        },
        "effectiveLimits": { "$ref": "#/$defs/pdbInputLimits" },
        "outcomes": {
          "type": "array", "maxItems": 33,
          "items": { "$ref": "#/$defs/pdbInputOutcome" }
        },
        "boundedInputSha256": { "$ref": "#/$defs/sha256" },
        "artifactVisibility": { "const": "local-only" },
        "coverageState": { "enum": ["pdb-complete", "pdb-partial"] },
        "omittedInputCount": { "type": "integer", "minimum": 0 },
        "omittedInputSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "pdbInputLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxArtifactCount", "maxFileSizeBytes", "maxDocumentCount", "maxMethodCount",
        "maxSequencePointCount", "maxTextLength", "maxTotalWorkUnits"
      ],
      "properties": {
        "maxArtifactCount": { "type": "integer", "minimum": 1 },
        "maxFileSizeBytes": { "type": "integer", "minimum": 1 },
        "maxDocumentCount": { "type": "integer", "minimum": 1 },
        "maxMethodCount": { "type": "integer", "minimum": 1 },
        "maxSequencePointCount": { "type": "integer", "minimum": 1 },
        "maxTextLength": { "type": "integer", "minimum": 1 },
        "maxTotalWorkUnits": { "type": "integer", "minimum": 1 }
      }
    },
    "pdbInputOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safeLocator", "outcome", "format", "rawFileSha256", "privacyProjectedInputSha256",
        "pdbContentId", "matchedAssemblySafeLocator", "matchedAssemblyIdentity",
        "provenanceBindingInputSha256", "bindingState", "gapKinds"
      ],
      "properties": {
        "safeLocator": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "outcome": { "enum": ["admitted", "missing", "unreadable", "malformed", "mismatched", "ambiguous", "unbound", "unsupported", "unsupported-platform", "disputed", "limit-exhausted"] },
        "format": { "enum": ["portable", "windows-pdb", "unknown"] },
        "rawFileSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "privacyProjectedInputSha256": { "$ref": "#/$defs/sha256" },
        "pdbContentId": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9a-f]{8}$" }, { "type": "null" }] },
        "matchedAssemblySafeLocator": { "oneOf": [{ "type": "string", "maxLength": 4096 }, { "type": "null" }] },
        "matchedAssemblyIdentity": { "oneOf": [{ "type": "string", "maxLength": 4096 }, { "type": "null" }] },
        "provenanceBindingInputSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "bindingState": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gapKinds": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "pdbEvidenceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "coverageState", "boundedInputSha256", "generatorSha256",
        "documentCount", "methodCount", "sequencePointCount", "metadataMethodJoinCount",
        "sourceDocumentJoinCount", "explicitGapCount", "entries", "omittedEntryCount", "omittedEntrySha256"
      ],
      "properties": {
        "schemaVersion": { "const": "pdb-evidence-summary.v1" },
        "coverageState": { "enum": ["pdb-complete", "pdb-partial"] },
        "boundedInputSha256": { "$ref": "#/$defs/sha256" },
        "generatorSha256": { "$ref": "#/$defs/sha256" },
        "documentCount": { "type": "integer", "minimum": 0 },
        "methodCount": { "type": "integer", "minimum": 0 },
        "sequencePointCount": { "type": "integer", "minimum": 0 },
        "metadataMethodJoinCount": { "type": "integer", "minimum": 0 },
        "sourceDocumentJoinCount": { "type": "integer", "minimum": 0 },
        "explicitGapCount": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array", "maxItems": 256,
          "items": { "$ref": "#/$defs/pdbEvidenceSummaryEntry" }
        },
        "omittedEntryCount": { "type": "integer", "minimum": 0 },
        "omittedEntrySha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "pdbEvidenceSummaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factType", "sourceIdentity", "targetIdentity", "evidenceFactId", "supportingFactIds",
        "ruleId", "evidenceTier", "extractorVersion", "provenanceState",
        "provenanceBindingInputSha256", "limitation"
      ],
      "properties": {
        "factType": { "enum": ["MetadataPdbMethodReconciled", "PdbSourceDocumentReconciled", "PdbSequencePointDeclared"] },
        "sourceIdentity": { "type": "string", "maxLength": 4096 },
        "targetIdentity": { "type": "string", "maxLength": 4096 },
        "evidenceFactId": { "type": "string", "pattern": "^fact-[0-9a-f]{20}$" },
        "supportingFactIds": { "$ref": "#/$defs/supportingFactIds" },
        "ruleId": { "enum": ["dotnet.compiled.pdb-identity.v1", "dotnet.compiled.sequence-point.v1"] },
        "evidenceTier": { "enum": ["Tier1Semantic", "Tier2Structural"] },
        "extractorVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "provenanceState": { "type": "string", "minLength": 1, "maxLength": 64 },
        "provenanceBindingInputSha256": { "$ref": "#/$defs/sha256" },
        "limitation": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageId", "stage", "operationCode", "attempt", "durationMilliseconds", "outcome",
        "coverageBefore", "coverageAfter", "lastProvenSafeState", "mutationState",
        "cleanupResult", "retryability", "nextAction", "supportingFactIds",
        "supportingGapIds", "limitations"
      ],
      "properties": {
        "stageId": { "type": "string", "pattern": "^stage-[0-9a-f]{20}$" },
        "stage": { "enum": ["discovery", "semantic-analysis", "static-extraction", "source-verification", "artifact-write", "other"] },
        "operationCode": {
          "enum": [
            "inventory-and-identity", "compiler-and-syntax-analysis", "deterministic-fact-extraction",
            "pre-extraction-snapshot-verification", "post-extraction-snapshot-verification", "manifest-write", "facts-write", "index-write",
            "output-directory-prepare", "report-write", "analyzer-log-write", "receipt-write", "webforms-static-extraction", "other"
          ]
        },
        "attempt": { "const": 1 },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "outcome": { "$ref": "#/$defs/outcome" },
        "coverageBefore": { "$ref": "#/$defs/coverage" },
        "coverageAfter": { "$ref": "#/$defs/coverage" },
        "lastProvenSafeState": {
          "enum": [
            "stage-started", "inventory-and-commit-observed", "semantic-input-snapshot-verified",
            "syntax-fallback-completed", "facts-created", "source-snapshot-verified", "manifest-written",
            "output-directory-prepared", "facts-written", "index-written", "report-written", "analyzer-log-written", "unknown"
          ]
        },
        "mutationState": { "enum": ["none-observed", "occurred", "unknown"] },
        "cleanupResult": { "enum": ["not-required", "completed", "not-attempted", "failed", "unknown"] },
        "retryability": {
          "enum": [
            "not-required", "retry-after-dependency-restoration", "retry-after-input-correction",
            "retry-after-owner-review", "retry-after-correction", "unknown"
          ]
        },
        "nextAction": { "type": "string", "pattern": "^[a-z0-9-]{1,80}$" },
        "supportingFactIds": { "$ref": "#/$defs/supportingFactIds" },
        "supportingGapIds": { "$ref": "#/$defs/supportingGapIds" },
        "limitations": { "$ref": "#/$defs/limitations" }
      }
    }
  }
}
