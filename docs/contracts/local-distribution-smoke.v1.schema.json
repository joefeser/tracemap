{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemap.tools/contracts/local-distribution-smoke.v1.schema.json",
  "title": "TraceMap local distribution synthetic smoke receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "head", "host", "recommendedCandidate", "selectionStatus", "candidates", "checks", "limitations"],
  "properties": {
    "schemaVersion": { "const": "local-distribution-smoke.v1" },
    "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "architecture", "runtimeVersion", "runtimeIdentifier"],
      "properties": {
        "operatingSystem": { "enum": ["windows", "macos", "linux"] },
        "architecture": { "enum": ["x64", "x86", "arm64", "arm", "s390x", "loongarch64", "ppc64le"] },
        "runtimeVersion": { "type": "string", "minLength": 1 },
        "runtimeIdentifier": { "type": "string", "pattern": "^(win|osx|linux)-[a-z0-9]+$" }
      }
    },
    "recommendedCandidate": { "const": "dotnet-tool" },
    "selectionStatus": { "enum": ["pending-cross-platform-ci", "selected"] },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["kind", "status", "lifecycle"],
        "properties": {
          "kind": { "enum": ["dotnet-tool", "framework-dependent-archive", "self-contained-archive", "offline-container"] },
          "status": { "enum": ["supported", "unsupported", "not-selected", "not-run"] },
          "lifecycle": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "limitation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageContent", "packageSizeBudget", "outsideCheckout", "guidedWorkflow", "upgrade", "uninstall"],
      "properties": {
        "packageContent": { "const": "passed" },
        "packageSizeBudget": { "const": "passed" },
        "outsideCheckout": { "const": "passed" },
        "guidedWorkflow": { "const": "passed" },
        "upgrade": { "const": "passed" },
        "uninstall": { "const": "passed" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
